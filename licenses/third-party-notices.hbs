<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>kVNC third-party licenses</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { overflow-wrap: anywhere; white-space: pre-wrap; }
    .license { border-top: 1px solid #ccc; margin-top: 2rem; padding-top: 1rem; }
  </style>
</head>
<body>
  <main>
    <h1>kVNC third-party license notices</h1>
    <p>
      This file is generated from the locked Rust dependency graph with
      cargo-about. It is included with every kVNC binary distribution.
    </p>

    <h2>License overview</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>

    <h2>Full license texts and covered crates</h2>
    {{#each licenses}}
    <section class="license">
      {{#if first_of_kind}}
      <h3 id="{{id}}">{{name}}</h3>
      {{/if}}
      <h4>{{name}}</h4>
      <ul>
        {{#each used_by}}
        <li>
          <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>
        </li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
